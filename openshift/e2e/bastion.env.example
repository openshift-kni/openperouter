# Shared bastion / containerlab access variables
#
# Cluster 7 dual-leaf lab map (HV tags VLANs; guest NICs are untagged):
#   VLAN 101 → eth1 → toswitch1 → leafkind1
#   VLAN 177 → eth2 → toswitch2 → leafkind2
#   eth0     = mgmt / SSH / default route only
#   VLAN 178 = spare (MetalLB / future)
#
#   set -a && source openshift/e2e/bastion.env.example && set +a
#   ./openshift/e2e/setup-bastion-bridges.sh
#
# Do NOT put a default gateway on lab ifaces (breaks SSH/mgmt on eth0).
# setup-bastion-bridges.sh pins NM: eth0 = mgmt; eth1/eth2 = ipv4/ipv6 disabled + never-default.

CLAB_EXECUTOR=local
CLAB_BASTION_MGMT_IFACE=eth0

CLAB_BASTION_HOST=registry.hlxcl7.lab.eng.tlv2.redhat.com
CLAB_BASTION_USER=telcov10n
CLAB_BASTION_SSH=telcov10n@registry.hlxcl7.lab.eng.tlv2.redhat.com
CLAB_BASTION_WORKDIR=/home/telcov10n/openperouter

CLAB_RUNTIME=podman

# Dual lab NICs → OpenPE toswitch bridges
CLAB_BASTION_LAB_IFACE_TOSWITCH1=eth1
CLAB_BASTION_LAB_IFACE_TOSWITCH2=eth2
CLAB_BASTION_ATTACH_LAB_IFACE=true

# Back-compat alias (toswitch1 leg)
CLAB_BASTION_LAB_IFACE=eth1

OPENPE_E2E_PROVIDER=bastion
OPENPE_CLAB_RUNTIME=${CLAB_RUNTIME}
OPENPE_BASTION_LAB_IFACE=${CLAB_BASTION_LAB_IFACE}
OPENPE_BASTION_ATTACH_LAB_IFACE=${CLAB_BASTION_ATTACH_LAB_IFACE}
# Skip virsh worker NIC/IP until lab uplink + worker secondary NICs are ready
OPENPE_BASTION_SKIP_WORKER_NET=true
# Skip leafSRV6/hostSRV6_* setups — SRv6 sysctls hang this bastion under podman
OPENPE_BASTION_SKIP_SRV6_SETUP=true
# Ginkgo container CLI: must see rootful clab (setup uses sudo podman).
# run_tests.sh defaults to openshift/e2e/podman-root.sh when provider=bastion.
# CONTAINER_RUNTIME=openshift/e2e/podman-root.sh

# KUBECONFIG=/home/telcov10n/project/generated/hlxcl7/auth/kubeconfig

# Only include underlay-capable nodes in nodelink.json (masters excluded).
# CNF MCP workercnf → often: node-role.kubernetes.io/workercnf
# ECO: ECO_CNF_CORE_NET_CNF_MCP_LABEL=workercnf
OPENPE_E2E_NODE_SELECTOR=node-role.kubernetes.io/worker
# Keep .103/.104 if those IPs are already on workers:
# OPENPE_BASTION_NODE_IP_BASE=103

# run_tests.sh focus/skip (regex). Default expands beyond Single Session Baseline.
# OPENPE_E2E_FOCUS='Single.Session.Baseline|Node.Router.Status|Router.BGP.sessions|North/south.traffic.after.FRR'
# OPENPE_E2E_NAMESPACE=openperouter-system

# Enable CNO additionalRoutingCapabilities FRR (frr-k8s) during deploy-bastion.
# Not a cluster default; required for OpenPE host-session e2e.
OPENPE_E2E_DEPLOY_FRRK8S=true
# After e2e, remove CNO FRR if this run enabled it (marker file). Use force to always remove.
OPENPE_E2E_TEARDOWN_FRRK8S=true
# OPENPE_E2E_TEARDOWN_FRRK8S=force
# OPENPE_E2E_TEARDOWN_FRRK8S=false

# Worker underlay IPs: applied before Ginkgo, removed on EXIT (see configure/teardown-bastion-worker-net.sh)
OPENPE_E2E_TEARDOWN_WORKER_NET=true
# OPENPE_UNDERLAY_IFACE=ens8f0np0
# OPENPE_BASTION_NODE_IP_BASE=103
